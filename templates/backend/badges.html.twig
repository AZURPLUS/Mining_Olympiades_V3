<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BADGE{% endblock %}</title>
    <link rel="icon" href="{{ absolute_url(asset('default/fichiers/logo.png')) }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .feuille {
            width: 210mm;
            height: 296mm;
            display: grid;
            grid-template-columns: repeat(2, 105mm);
            grid-template-rows: repeat(2, 148mm);
            margin: 0 auto 20px;
            background: white;
        }

        .badge-slot {
            width: 105mm;
            height: 148mm;
            overflow: hidden;
        }

        @page { size: A4 portrait; margin: 0; }

        @media print {
            body > .container { max-width: none; padding: 0; }
            #exportButtonContainer, .navigation { display: none !important; }
            .feuille { margin: 0; break-after: page; }
            .feuille:last-child { break-after: auto; }
            .badge { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        }
        .badge {
            width: 105mm;
            height: 148mm !important;
            border: 0;
            border-radius: 0;
            white-space: normal;
            background-image: url({{ asset('assets/images/badge_2026.jpeg') }});
            background-size: contain;
            background-repeat: no-repeat;
            color: #000;
            display: flex;
        }

        .info {
            margin-top: 93px;
        }

        .licence {
            margin-left: 15px;
            font-weight: bold;
            font-size: 1.2rem;
            color: #039404;
        }

        .photo {
            margin: 0 auto;
        }

        .photo img {
            width: 100px;
            max-height: 120px;
            min-height: 120px;
            border-radius: 10px;
            border-top: solid 5px darkorange ;
            border-bottom: solid 5px darkorange ;
            border-left: solid 1px darkorange;
            border-right: solid 1px darkorange;
        }

        .label {
            font-size: .8rem;
            font-weight: 700;
        }

        .donnees {
            font-weight: bold;
            color: #039404;
            margin-top: 1px;
            font-size: 1.1rem;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="row">
        <div class="col-12 text-center mt-3 mb-3" id="exportButtonContainer">
            <button id="exportPdf" class="btn btn-primary" onclick="exportToPDF()" {{ joueurs is empty ? 'disabled' : '' }}>Exporter en PDF A4 (4 licences par page)</button>
            <div id="exportStatus" class="mt-2" role="status" aria-live="polite"></div>
        </div>
    </div>
    <div id="licences">
        {% for groupe in joueurs|batch(4) %}
        <div class="feuille">
        {% for joueur in groupe %}
            <div class="badge-slot">
                <div class="card badge">
                    <div class="card-body">
                        <div class="row info">
                            <div class="col-md-12">
                                <div class="row">
                                    <div class="col-12 mb-3 licence"> {{ joueur.licence }} </div>
                                    <div class="col-12 photo d-flex justify-content-center align-content-center align-items-center">
                                        <img src="{{ joueur.media ? absolute_url(asset('upload/participant/' ~ joueur.compagnieSlug ~ '/' ~ joueur.media)) : absolute_url(asset('assets/images/avatar.png')) }}" alt="" class="img-fluid">
                                    </div>
                                    <div class="col-12 mt-3">
                                        <div class="label">Entreprise</div>
                                        <div class="donnees">{{ joueur.entreprise }}</div>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="label">Nom</div>
                                        <div class="donnees">{{ joueur.nom }}</div>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="label">Prénoms</div>
                                        <div class="donnees">{{ joueur.prenoms }}</div>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="label">Matricule</div>
                                        <div class="donnees">{{ joueur.matricule }}</div>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="label">Contact</div>
                                        <div class="donnees">{{ joueur.contact }}</div>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="label">Discipline</div>
                                        <div class="donnees">{{ joueur.discipline}} </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
        {% endfor %}
    </div>
    {% if flag %}
        <div class="row text-center mt-5 navigation">
            <div class="col">
                <form action="">
                    <input type="hidden" name="flag" value="{{ flag }}">
                    <button class="btn btn-sm btn-outline-primary">plus</button>
                </form>
            </div>
        </div>
    {% endif %}
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    async function exportToPDF() {
        const sheets = document.querySelectorAll('.feuille');
        const button = document.getElementById('exportPdf');
        const status = document.getElementById('exportStatus');
        if (!sheets.length || button.disabled) return;

        button.disabled = true;
        try {
            await document.fonts.ready;
            await Promise.all(Array.from(document.querySelectorAll('#licences img')).map(img => {
                if (img.complete) return Promise.resolve();
                return new Promise(resolve => {
                    img.addEventListener('load', resolve, { once: true });
                    img.addEventListener('error', resolve, { once: true });
                });
            }));

            let pdf;
            for (let index = 0; index < sheets.length; index++) {
                status.textContent = `Préparation de la page ${index + 1} sur ${sheets.length}…`;
                const worker = html2pdf().set({
                    margin: 0,
                    image: { type: 'jpeg', quality: 0.98 },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                    pagebreak: { mode: [] },
                }).from(sheets[index]).toCanvas();
                const canvas = await worker.get('canvas');
                if (!pdf) {
                    pdf = await worker.toPdf().get('pdf');
                } else {
                    pdf.addPage('a4', 'portrait');
                    pdf.addImage(canvas.toDataURL('image/jpeg', 0.98), 'JPEG', 0, 0, 210, 296);
                }
                canvas.width = 0;
                canvas.height = 0;
            }
            pdf.save('licences-a4.pdf');
            status.textContent = 'PDF prêt : 4 licences par page A4. Imprimez à taille réelle (100 %).';
        } catch (error) {
            console.error('Erreur lors de l’export des licences :', error);
            status.textContent = 'L’export a échoué. Veuillez réessayer.';
        } finally {
            button.disabled = false;
        }
    }
</script>
</body>
</html>
