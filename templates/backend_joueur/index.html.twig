{% extends 'backend_layout.html.twig' %}

{% block title %}{{ parent() }} Gestion des participants{% endblock %}

{% block body %}

    <div class="container-fluid">
        <div class="card bg-light-info shadow-none position-relative overflow-hidden">
            <div class="card-body px-4 py-3">
                <div class="row align-items-center">
                    <div class="col-9">
                        <h4 class="fw-semibold mb-8">Gestion des participants</h4>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a class="text-muted" href="#">Modules</a></li>
                                <li class="breadcrumb-item"><a class="text-muted" href="#">Compétition</a></li>
                                <li class="breadcrumb-item" aria-current="page">participants</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-3">
                        <div class="text-center mb-n5">
                            <span class="head-icon"><i class="ti-package"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <section>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="row">
                                <div class="col"><h5 class="mb-2 fw-semibold fs-4">Liste</h5></div>

                            </div>

                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="listes" class="table  border table-striped table-bordered display text-nowrap" style="width: 100%;">
                                    <thead>
                                    <tr>
                                        <th class="text-center text-uppercase">#</th>
                                        <th class="text-center text-uppercase">SOCIETE</th>
                                        <th class="text-center text-uppercase">NOM & PRENOMS</th>
                                        <th class="text-center text-uppercase">MATRICULE</th>
                                        <th class="text-center text-uppercase">CONTACT</th>
                                        <th class="text-center text-uppercase">EMAIL</th>
                                        <th class="text-center text-uppercase">LICENCE</th>
                                        <th class="text-center text-uppercase">DISCIPLINE</th>
                                        <th class="text-center text-uppercase">STATUT</th>
                                        <th class="text-center text-uppercase">ACTIONS</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for participant in joueurs %}
                                        <tr>
                                            <td>{{ loop.index }}</td>
                                            <td>{{ participant.abonnement.compagnie.titre }}</td>
                                            <td>{{ participant.nom }} {{ participant.prenoms }}</td>
                                            <td>{{ participant.matricule }}</td>
                                            <td>{{ participant.contact }}</td>
                                            <td>{{ participant.email }}</td>
                                            <td>{{ participant.licence }}</td>
                                            <td>
                                                {% for competir in participant.discipline %}
                                                    {{ competir.titre }}
                                                {% endfor %}
                                            </td>
                                            <td class="text-center">
                                                {% if participant.status == 'validated' %}
                                                    <span class="badge bg-success">Validé</span>
                                                {% elseif participant.status == 'rejected' %}
                                                    <span class="badge bg-danger badge-rejete" style="cursor:pointer" data-msg="{{ participant.rejectMessage|e('html_attr') }}">Rejeté <i class="ti-info-alt"></i></span>
                                                {% else %}
                                                    <span class="badge bg-warning text-dark">En attente</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                <a href="{{ path('app_backend_joueur_show', {'id': participant.id}) }}" class="me-2"><i class="ti-user"></i></a>
                                                {% if participant.status != 'validated' %}
                                                    <button class="btn btn-sm btn-success btn-valider ms-1" data-id="{{ participant.id }}" data-nom="{{ participant.nom }} {{ participant.prenoms }}" data-token="{{ csrf_token('valider' ~ participant.id) }}"><i class="ti-check"></i></button>
                                                {% endif %}
                                                {% if participant.status != 'rejected' %}
                                                    <button class="btn btn-sm btn-danger btn-rejeter ms-1" data-id="{{ participant.id }}" data-nom="{{ participant.nom }} {{ participant.prenoms }}" data-token="{{ csrf_token('rejeter' ~ participant.id) }}"><i class="ti-close"></i></button>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td class="text-center" colspan="10">Aucun participant trouvé</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>


    </div>

{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ absolute_url(asset('backoffice/vendor/css/prism.min.css')) }}">
    <link rel="stylesheet" href="{{ absolute_url(asset('backoffice/vendor/DataTables/datatables.min.css')) }}">
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ absolute_url(asset('backoffice/vendor/js/prism.js')) }}"></script>
    <script src="{{ absolute_url(asset('backoffice/vendor/DataTables/datatables.min.js')) }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const table = $('#listes').DataTable({dom:'Bfrtip',scrollX:true,buttons:['copy','excel','pdf']});

        document.querySelectorAll('.badge-rejete').forEach(el => {
            el.addEventListener('click', function () {
                Swal.fire('Motif du rejet', this.dataset.msg, 'info');
            });
        });

        document.querySelectorAll('.btn-valider').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.dataset.id;
                const nom = this.dataset.nom;
                const token = this.dataset.token;
                Swal.fire({
                    title: 'Valider ' + nom + ' ?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Oui, valider',
                    cancelButtonText: 'Annuler',
                    confirmButtonColor: '#468f34',
                }).then(result => {
                    if (!result.isConfirmed) return;
                    const formData = new FormData();
                    formData.append('_token', token);
                    fetch('{{ absolute_url(path('app_backend_joueur_valider', {id: 0})) }}'.replace('0', id), {
                        method: 'POST', body: formData
                    }).then(r => r.json()).then(data => {
                        if (data.success) { Swal.fire('Validé !', data.message, 'success').then(() => location.reload()); }
                        else { Swal.fire('Erreur', data.error, 'error'); }
                    });
                });
            });
        });

        document.querySelectorAll('.btn-rejeter').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.dataset.id;
                const nom = this.dataset.nom;
                const token = this.dataset.token;
                Swal.fire({
                    title: 'Rejeter ' + nom + ' ?',
                    input: 'textarea',
                    inputLabel: 'Motif du rejet',
                    inputPlaceholder: 'Saisissez le motif...',
                    showCancelButton: true,
                    confirmButtonText: 'Rejeter',
                    cancelButtonText: 'Annuler',
                    confirmButtonColor: '#d33',
                }).then(result => {
                    if (!result.isConfirmed || !result.value) return;
                    const formData = new FormData();
                    formData.append('_token', token);
                    formData.append('motif', result.value);
                    fetch('{{ absolute_url(path('app_backend_joueur_rejeter', {id: 0})) }}'.replace('0', id), {
                        method: 'POST', body: formData
                    }).then(r => r.json()).then(data => {
                        if (data.success) { Swal.fire('Rejeté !', data.message, 'success').then(() => location.reload()); }
                        else { Swal.fire('Erreur', data.error, 'error'); }
                    });
                });
            });
        });
    </script>
{% endblock %}
