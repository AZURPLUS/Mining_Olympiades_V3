{% extends 'base.html.twig' %}

{% block title %}Facture{% endblock %}

{% block body %}
    <main>
        <div class="container mt-5 pt-4">
            <div class="row mb-4">
                <div class="col-12">
                    <a href="{{ absolute_url(path('app_frontend_membre_index')) }}" class="btn btn-sm btn-outline-secondary mb-2">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                    <h2 class="fw-bold" style="color:#468f34;">Facture</h2>
                    <p class="text-muted">Récapitulatif de votre abonnement</p>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card shadow-sm" style="border:none;border-radius:12px;">
                        <div class="card-body p-4">
                            <div class="text-center mb-4">
                                <img src="{{ absolute_url(asset('default/fichiers/logo.png')) }}" alt="Logo" style="max-height:60px;">
                                <h4 class="fw-bold mt-2" style="color:#468f34;">Mining Olympiades</h4>
                                <p class="text-muted small">Facture n° <strong>{{ abonnement.reference }}</strong></p>
                            </div>

                            <hr>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6 class="fw-bold small text-uppercase text-muted">Société</h6>
                                    <p class="mb-1 fw-medium">{{ compagnie.titre }}</p>
                                    <p class="mb-1 small">{{ compagnie.dg }}</p>
                                    <p class="mb-1 small">{{ compagnie.representant }}</p>
                                    <p class="mb-1 small">{{ compagnie.contact }}</p>
                                    <p class="mb-0 small">{{ compagnie.email }}</p>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <h6 class="fw-bold small text-uppercase text-muted">Abonnement</h6>
                                    <p class="mb-1 small">Référence : <strong>{{ abonnement.reference }}</strong></p>
                                    <p class="mb-1 small">Année : {{ abonnement.annee }}</p>
                                    <p class="mb-1 small">Date : {{ abonnement.createdAt|date('d/m/Y') }}</p>
                                    <p class="mb-0 small">Statut : {% if abonnement.solde %}<span class="badge bg-success">Payée</span>{% else %}<span class="badge bg-warning text-dark">Impayée</span>{% endif %}</p>
                                </div>
                            </div>

                            <h6 class="fw-bold small text-uppercase text-muted mb-2">Disciplines souscrites</h6>
                            <table class="table table-bordered table-sm">
                                <thead class="table-success">
                                <tr>
                                    <th>Discipline</th>
                                    <th class="text-center">Places</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for d in disciplines %}
                                    <tr>
                                        <td>{{ d.titre }}</td>
                                        <td class="text-center">{{ d.joueur }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>

                            <h6 class="fw-bold small text-uppercase text-muted mb-2 mt-3">Participants inscrits</h6>
                            <table class="table table-bordered table-sm">
                                <thead class="table-success">
                                <tr>
                                    <th>#</th>
                                    <th>Nom</th>
                                    <th>Prénom</th>
                                    <th>Matricule</th>
                                    <th>Licence</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for j in joueurs %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ j.nom }}</td>
                                        <td>{{ j.prenoms }}</td>
                                        <td>{{ j.matricule }}</td>
                                        <td>{{ j.licence }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">Aucun participant inscrit</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>

                            <hr>
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="small text-muted mb-0">Montant unitaire :</p>
                                    <p class="small text-muted">Nombre de participants :</p>
                                    <h5 class="fw-bold">Total :</h5>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <p class="small mb-0">{{ montantUnitaire|number_format(0, ',', ' ') }} F CFA</p>
                                    <p class="small">{{ totalJoueurs }}</p>
                                    <h5 class="fw-bold" style="color:#468f34;">{{ totalMontant|number_format(0, ',', ' ') }} F CFA</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block breadcrumb %}
    <div class="zoneBreadcrumb">
        <section id="breadcrumb">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ absolute_url(path('app_home')) }}"><i class="bi bi-house-fill"></i></a></li>
                    <li class="breadcrumb-item"><a href="{{ absolute_url(path('app_frontend_membre_index')) }}">Espace membre</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Facture</li>
                </ol>
            </nav>
        </section>
    </div>
{% endblock %}