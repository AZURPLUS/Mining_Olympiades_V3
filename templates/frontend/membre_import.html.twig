{% extends 'base.html.twig' %}

{% block title %}Import de participants{% endblock %}

{% block body %}
    <main>
        <div class="container mt-5 pt-4">
            <div class="row mb-4">
                <div class="col-12">
                    <a href="{{ absolute_url(path('app_frontend_membre_index')) }}" class="btn btn-sm btn-outline-secondary mb-2">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                    <h2 class="fw-bold" style="color:#468f34;">Import de participants</h2>
                    <p class="text-muted">Importez vos participants depuis un fichier Excel</p>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div id="step1" class="card shadow-sm mb-4" style="border:none;border-radius:12px;">
                        <div class="card-body p-4 text-center">
                            <div style="font-size:4rem;color:#468f34;margin-bottom:16px;">
                                <i class="bi bi-file-earmark-spreadsheet"></i>
                            </div>
                            <h5 class="fw-bold">Téléchargez le modèle</h5>
                            <p class="text-muted small">Remplissez le fichier Excel avec les informations de vos participants puis importez-le.</p>
                            <a href="{{ absolute_url(asset('default/model_participant_olympiades.xlsx')) }}" class="btn btn-success mb-3" style="border-radius:50px;background:#468f34;border-color:#468f34;">
                                <i class="bi bi-download"></i> Télécharger le modèle Excel
                            </a>
                            <div class="table-responsive mt-3">
                                <table class="table table-bordered table-sm mx-auto" style="max-width:500px;font-size:0.85rem;">
                                    <thead class="table-success">
                                    <tr>
                                        <th>NOM</th>
                                        <th>PRENOM</th>
                                        <th>TELEPHONE</th>
                                        <th>EMAIL</th>
                                        <th>MATRICULE</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>KOFFI</td>
                                        <td>Jean</td>
                                        <td>0102030405</td>
                                        <td>jean@email.com</td>
                                        <td>MT001</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div id="step2" class="card shadow-sm mb-4" style="border:none;border-radius:12px;">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3" style="color:#468f34;"><i class="bi bi-upload"></i> Importer le fichier</h5>

                            {% if disciplines is defined and disciplines is not empty %}
                                <div class="mb-3">
                                    <label class="form-label fw-medium">Assigner à la discipline</label>
                                    <select id="importDiscipline" class="form-select">
                                        <option value="0">— Aucune discipline (à assigner plus tard) —</option>
                                        {% for d in disciplines %}
                                            <option value="{{ d.id }}">{{ d.titre }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                <div id="dropZone" class="border-2 border-dashed rounded-3 p-5 text-center" style="border:2px dashed #ccc;cursor:pointer;transition:all 0.2s;">
                                    <div style="font-size:3rem;color:#ccc;margin-bottom:12px;">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                    </div>
                                    <h6 class="fw-medium">Glissez-déposez votre fichier ici</h6>
                                    <p class="text-muted small mb-3">ou cliquez pour parcourir</p>
                                    <input type="file" id="fileInput" accept=".xlsx,.xls" class="d-none">
                                    <button type="button" class="btn btn-outline-success btn-sm" id="browseBtn" style="border-radius:50px;">
                                        <i class="bi bi-folder2-open"></i> Parcourir
                                    </button>
                                    <p id="fileNameDisplay" class="mt-2 mb-0 small text-success d-none"></p>
                                </div>
                            </div>

                            <div id="step3" class="d-none mt-4">
                                <h6 class="fw-bold mb-2"><i class="bi bi-eye"></i> Aperçu des données</h6>
                                <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                                    <table class="table table-sm table-bordered" id="previewTable">
                                        <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>NOM</th>
                                            <th>PRENOM</th>
                                            <th>TELEPHONE</th>
                                            <th>EMAIL</th>
                                            <th>MATRICULE</th>
                                        </tr>
                                        </thead>
                                        <tbody id="previewBody"></tbody>
                                    </table>
                                </div>
                                <p id="rowCountInfo" class="text-muted small mt-2"></p>

                                <button type="button" class="btn btn-success mt-2" id="startImportBtn" style="border-radius:50px;padding:10px 40px;background:#468f34;border-color:#468f34;">
                                    <i class="bi bi-rocket-takeoff"></i> Lancer l'import
                                </button>
                            </div>

                            <div id="step4" class="d-none mt-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-arrow-repeat"></i> Import en cours...</h6>
                                <div class="progress" style="height:24px;border-radius:50px;">
                                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                                         style="width:0%;background:#468f34;border-radius:50px;" role="progressbar">0%</div>
                                </div>
                                <p id="progressText" class="text-muted small mt-2 text-center"></p>
                                <div id="importResult" class="mt-3 d-none">
                                    <div class="alert py-2" id="importResultAlert"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block breadcrumb %}
    <div class="zoneBreadcrumb">
        <section id="breadcrumb">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ absolute_url(path('app_home')) }}"><i class="bi bi-house-fill"></i></a></li>
                    <li class="breadcrumb-item"><a href="{{ absolute_url(path('app_frontend_membre_index')) }}">Espace membre</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Import</li>
                </ol>
            </nav>
        </section>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #dropZone.dragover { border-color: #468f34 !important; background: #fffdfa; }
        #dropZone.dragover i { color: #468f34 !important; }
        .table-success { --bs-table-bg: #468f34; --bs-table-color: #fff; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        let parsedRows = [];
        const CHUNK_SIZE = 10;

        document.addEventListener('DOMContentLoaded', function () {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const browseBtn = document.getElementById('browseBtn');
            const fileNameDisplay = document.getElementById('fileNameDisplay');

            browseBtn.addEventListener('click', () => fileInput.click());

            dropZone.addEventListener('click', (e) => {
                if (e.target !== browseBtn && !browseBtn.contains(e.target)) {
                    fileInput.click();
                }
            });

            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });

            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('dragover');
            });

            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                if (e.dataTransfer.files.length) {
                    handleFile(e.dataTransfer.files[0]);
                }
            });

            fileInput.addEventListener('change', () => {
                if (fileInput.files.length) {
                    handleFile(fileInput.files[0]);
                }
            });

            document.getElementById('startImportBtn').addEventListener('click', startImport);
        });

        function handleFile(file) {
            const ext = file.name.split('.').pop().toLowerCase();
            if (!['xlsx', 'xls'].includes(ext)) {
                Swal.fire('Format incorrect', 'Veuillez choisir un fichier Excel (.xlsx ou .xls)', 'error');
                return;
            }

            document.getElementById('fileNameDisplay').textContent = '✓ ' + file.name;
            document.getElementById('fileNameDisplay').classList.remove('d-none');

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, {type: 'array'});
                    const sheet = workbook.Sheets[workbook.SheetNames[0]];
                    const json = XLSX.utils.sheet_to_json(sheet, {defval: ''});

                    if (json.length === 0) {
                        Swal.fire('Fichier vide', 'Le fichier ne contient aucune donnée.', 'warning');
                        return;
                    }

                    const headers = Object.keys(json[0]).map(h => h.toUpperCase().trim());
                    const expectedHeaders = ['NOM', 'PRENOM', 'TELEPHONE', 'EMAIL', 'MATRICULE'];

                    const missing = expectedHeaders.filter(h => !headers.includes(h));
                    if (missing.length > 0) {
                        Swal.fire('En-têtes invalides',
                            'Colonnes manquantes : ' + missing.join(', ') + '<br>Utilisez le modèle fourni.',
                            'error');
                        return;
                    }

                    parsedRows = json.map(row => ({
                        NOM: (row['NOM'] || '').toString().trim(),
                        PRENOM: (row['PRENOM'] || '').toString().trim(),
                        TELEPHONE: (row['TELEPHONE'] || '').toString().trim(),
                        EMAIL: (row['EMAIL'] || '').toString().trim(),
                        MATRICULE: (row['MATRICULE'] || '').toString().trim(),
                    })).filter(r => r.NOM && r.PRENOM);

                    if (parsedRows.length === 0) {
                        Swal.fire('Aucune donnée valide', 'Assurez-vous que chaque ligne a un NOM et un PRENOM.', 'warning');
                        return;
                    }

                    if (parsedRows.length > 2000) {
                        Swal.fire('Trop de lignes', 'Maximum 2000 lignes autorisées. Votre fichier en contient ' + parsedRows.length + '.', 'error');
                        return;
                    }

                    showPreview(parsedRows);
                    document.getElementById('step3').classList.remove('d-none');

                } catch (err) {
                    console.error(err);
                    Swal.fire('Erreur de lecture', 'Impossible de lire le fichier. Vérifiez son format.', 'error');
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function showPreview(rows) {
            const tbody = document.getElementById('previewBody');
            const preview = rows.slice(0, 20);
            tbody.innerHTML = preview.map((r, i) =>
                `<tr>
                    <td>${i + 1}</td>
                    <td>${escapeHtml(r.NOM)}</td>
                    <td>${escapeHtml(r.PRENOM)}</td>
                    <td>${escapeHtml(r.TELEPHONE)}</td>
                    <td>${escapeHtml(r.EMAIL)}</td>
                    <td>${escapeHtml(r.MATRICULE)}</td>
                </tr>`
            ).join('');

            const more = rows.length - 20;
            if (more > 0) {
                tbody.innerHTML += `<tr><td colspan="6" class="text-muted text-center small">... et ${more} ligne(s) supplémentaire(s)</td></tr>`;
            }

            document.getElementById('rowCountInfo').textContent = rows.length + ' participant(s) détecté(s)';
        }

        async function startImport() {
            const totalRows = parsedRows.length;
            if (totalRows === 0) return;

            const disciplineId = parseInt(document.getElementById('importDiscipline')?.value || 0);

            document.getElementById('step4').classList.remove('d-none');
            document.getElementById('startImportBtn').disabled = true;
            document.getElementById('startImportBtn').innerHTML = '<span class="spinner-border spinner-border-sm"></span> Import...';

            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            const resultAlert = document.getElementById('importResult');
            const resultAlertDiv = document.getElementById('importResultAlert');

let totalProcessed = 0;
                    let totalSkipped = 0;
                    let hasError = false;

            const chunks = [];
            for (let i = 0; i < totalRows; i += CHUNK_SIZE) {
                chunks.push(parsedRows.slice(i, i + CHUNK_SIZE));
            }

            for (let ci = 0; ci < chunks.length; ci++) {
                try {
                    const resp = await fetch('{{ absolute_url(path('app_frontend_membre_api_import_process')) }}', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            rows: chunks[ci],
                            chunkIndex: ci,
                            disciplineId: disciplineId,
                        }),
                    });

                    const data = await resp.json();
                    if (data.success) {
                        totalProcessed += data.processed || 0;
                        totalSkipped += data.skipped || 0;
                    } else {
                        hasError = true;
                    }
                } catch (err) {
                    hasError = true;
                }

                const pct = Math.round(((ci + 1) / chunks.length) * 100);
                progressBar.style.width = pct + '%';
                progressBar.textContent = pct + '%';
                progressText.textContent = `${Math.min(totalProcessed, (ci + 1) * CHUNK_SIZE)} / ${totalRows} participants importés`;
            }

            progressBar.classList.remove('progress-bar-animated');
            resultAlert.classList.remove('d-none');

            if (hasError) {
                resultAlertDiv.className = 'alert alert-warning py-2';
                resultAlertDiv.innerHTML = `<i class="bi bi-exclamation-triangle"></i> Import terminé avec quelques erreurs. ${totalProcessed} importé(s)${totalSkipped ? ', ' + totalSkipped + ' doublon(s) ignoré(s)' : ''}.`;
            } else {
                let msg = `${totalProcessed} participant(s) importé(s) avec succès !`;
                if (totalSkipped > 0) msg += `<br><small class="text-muted">${totalSkipped} doublon(s) ignoré(s)</small>`;
                resultAlertDiv.className = 'alert alert-success py-2';
                resultAlertDiv.innerHTML = `<i class="bi bi-check-circle"></i> ${msg}`;
            }

            document.getElementById('startImportBtn').disabled = false;
            document.getElementById('startImportBtn').innerHTML = '<i class="bi bi-check-lg"></i> Redirection...';

            setTimeout(() => {
                window.location.href = '{{ absolute_url(path('app_frontend_membre_index')) }}';
            }, 1500);
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
{% endblock %}