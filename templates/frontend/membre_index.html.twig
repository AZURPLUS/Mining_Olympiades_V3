                    <button type="button" class="btn btn-primary" id="confirmInfo">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addParticipantModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;border:none;">
                <div class="modal-header" style="border:none;padding-bottom:0;">
                    <h5 class="modal-title fw-bold" style="color:#468f34;">Ajouter un participant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <a href="{{ absolute_url(path('app_frontend_membre_import')) }}" class="text-decoration-none">
                                <div class="choice-card p-4" style="border:2px solid #e0e0e0;border-radius:12px;cursor:pointer;transition:all 0.2s;">
                                    <div style="font-size:3rem;color:#468f34;margin-bottom:12px;">
                                        <i class="bi bi-file-earmark-spreadsheet"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1" style="color:#468f34;">Import Excel</h6>
                                    <small class="text-muted">Ajouter plusieurs participants<br>via un fichier Excel</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="{{ absolute_url(path('app_frontend_membre_add_participant')) }}" class="text-decoration-none">
                                <div class="choice-card p-4" style="border:2px solid #e0e0e0;border-radius:12px;cursor:pointer;transition:all 0.2s;">
                                    <div style="font-size:3rem;color:#ed741f;margin-bottom:12px;">
                                        <i class="bi bi-person-plus"></i>
