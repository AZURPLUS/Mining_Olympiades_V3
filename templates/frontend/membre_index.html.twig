{% extends 'base.html.twig' %}

{% block title %}Espace Membre{% endblock %}

{% block body %}
    <main>
        <div class="container mt-5 pt-4">
            <div class="row mb-4">
                <div class="col-12 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold" style="color: #0e9346;">Espace Membre</h2>
                        <p class="text-muted">Gérez vos disciplines et participants</p>
                    </div>
                    <a href="{{ absolute_url(path('app_logout')) }}" class="btn btn-outline-danger btn-sm" style="border-radius:50px;">
                        <i class="bi bi-box-arrow-right"></i> Déconnexion
                    </a>
                </div>
            </div>

            <ul class="nav nav-tabs mb-4" id="membreTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="disciplines-tab" data-bs-toggle="tab" data-bs-target="#disciplines" type="button" role="tab" aria-controls="disciplines" aria-selected="true">
                        <i class="bi bi-trophy"></i> Disciplines
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="participants-tab" data-bs-toggle="tab" data-bs-target="#participants" type="button" role="tab" aria-controls="participants" aria-selected="false">
                        <i class="bi bi-people"></i> Participants
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="facture-tab" data-bs-toggle="tab" data-bs-target="#facture" type="button" role="tab" aria-controls="facture" aria-selected="false">
                        <i class="bi bi-receipt"></i> Facture
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="notifications-tab" data-bs-toggle="tab" data-bs-target="#notifications" type="button" role="tab" aria-controls="notifications" aria-selected="false">
                        <i class="bi bi-bell"></i> Notifications
                        {% if unreadCount > 0 %}
                            <span class="badge bg-danger ms-1">{{ unreadCount }}</span>
                        {% endif %}
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="membreTabContent">
                <div class="tab-pane fade show active" id="disciplines" role="tabpanel" aria-labelledby="disciplines-tab">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Disciplines souscrites</h5>
                            <div class="d-flex gap-2">
                                <div class="btn-group">
                                    <button class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                        <i class="bi bi-download"></i> Exporter
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="{{ absolute_url(path('app_frontend_membre_export_disciplines', {format: 'csv'})) }}"><i class="bi bi-filetype-csv"></i> CSV</a></li>
                                        <li><a class="dropdown-item" href="{{ absolute_url(path('app_frontend_membre_export_disciplines', {format: 'xlsx'})) }}"><i class="bi bi-file-earmark-excel"></i> Excel</a></li>
                                        <li><a class="dropdown-item" href="{{ absolute_url(path('app_frontend_membre_export_disciplines', {format: 'pdf'})) }}"><i class="bi bi-filetype-pdf"></i> PDF</a></li>
                                    </ul>
                                </div>
                                <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addDisciplineModal">
                                    <i class="bi bi-plus-circle"></i> <span id="addDisciplineBtnLabel">Ajouter une discipline</span>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            {% if disciplines is empty %}
                                <div class="text-center py-4">
                                    <i class="bi bi-trophy" style="font-size: 3rem; color: #ddd;"></i>
                                    <p class="mt-2 text-muted">Aucune discipline sélectionnée.</p>
                                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addDisciplineModal">
                                        Choisir des disciplines
                                    </button>
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle" id="disciplinesTable">
                                        <thead class="table-light">
                                        <tr>
                                            <th>Titre</th>
                                            <th class="text-center">Inscrits</th>
                                            <th class="text-center">Requis</th>
                                            <th class="text-center">Restant</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for discipline in disciplines %}
                                            {% set stats = disciplineStats[discipline.id] ?? {count: 0, required: 0, remaining: 0} %}
                                            <tr id="discipline-row-{{ discipline.id }}">
                                                <td class="fw-medium">{{ discipline.titre }}</td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary rounded-pill">{{ stats.count }}</span>
                                                </td>
                                                <td class="text-center">{{ stats.required }}</td>
                                                <td class="text-center">
                                                    {% if stats.remaining > 0 %}
                                                        <span class="badge bg-warning text-dark">{{ stats.remaining }}</span>
                                                    {% else %}
                                                        <span class="badge bg-success">Complet</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-info voir-participants"
                                                                data-discipline-id="{{ discipline.id }}"
                                                                data-discipline-titre="{{ discipline.titre }}"
                                                                title="Voir participants">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button class="btn btn-outline-success ajouter-participant"
                                                                data-discipline-id="{{ discipline.id }}"
                                                                title="Ajouter participant">
                                                            <i class="bi bi-person-plus"></i>
                                                        </button>
                                                        <button class="btn btn-outline-warning modifier-discipline"
                                                                data-discipline-id="{{ discipline.id }}"
                                                                title="Modifier (changer de discipline)">
                                                            <i class="bi bi-arrow-repeat"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger supprimer-discipline"
                                                                data-discipline-id="{{ discipline.id }}"
                                                                data-discipline-titre="{{ discipline.titre }}"
                                                                title="Supprimer">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="participants" role="tabpanel" aria-labelledby="participants-tab">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">Liste des participants</h5>
                            <div class="d-flex gap-2">
                                <div class="btn-group">
                                    <button class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                        <i class="bi bi-download"></i> Exporter
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="{{ absolute_url(path('app_frontend_membre_export_participants', {format: 'csv'})) }}"><i class="bi bi-filetype-csv"></i> CSV</a></li>
                                        <li><a class="dropdown-item" href="{{ absolute_url(path('app_frontend_membre_export_participants', {format: 'xlsx'})) }}"><i class="bi bi-file-earmark-excel"></i> Excel</a></li>
                                        <li><a class="dropdown-item" href="{{ absolute_url(path('app_frontend_membre_export_participants', {format: 'pdf'})) }}"><i class="bi bi-filetype-pdf"></i> PDF (avec photos)</a></li>
                                    </ul>
                                </div>
                                <select id="filterDiscipline" class="form-select form-select-sm" style="width: auto;">
                                    <option value="0">Toutes les disciplines</option>
                                    {% for discipline in disciplines %}
                                        <option value="{{ discipline.id }}">{{ discipline.titre }}</option>
                                    {% endfor %}
                                </select>
                                <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addParticipantModal">
                                    <i class="bi bi-person-plus"></i> Ajouter
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle" id="participantsTable">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Photo</th>
                                        <th>Carte</th>
                                        <th>Nom</th>
                                        <th>Prénom</th>
                                        <th>Email</th>
                                        <th>Téléphone</th>
                                        <th>Matricule</th>
                                        <th>Licence</th>
                                        <th>Discipline(s)</th>
                                        <th>Statut</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody id="participantsBody">
                                    <tr id="participantsLoading">
                                        <td colspan="11" class="text-center py-4">
                                            <div class="spinner-border text-success" role="status">
                                                <span class="visually-hidden">Chargement...</span>
                                            </div>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                            <nav id="participantsPagination" class="mt-3"></nav>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="facture" role="tabpanel" aria-labelledby="facture-tab">
                    <div class="card shadow-sm" style="border:none;border-radius:12px;">
                        <div class="card-body p-4">
                            {% if abonnement %}
                                <div class="text-center mb-4">
                                    <img src="{{ absolute_url(asset('default/fichiers/logo.png')) }}" alt="Logo" style="max-height:50px;">
                                    <h4 class="fw-bold mt-2" style="color:#468f34;">Mining Olympiades</h4>
                                    <p class="text-muted small">Facture n° <strong>{{ abonnement.reference }}</strong></p>
                                </div>
                                <hr>
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <h6 class="fw-bold small text-uppercase text-muted">Société</h6>
                                        <p class="mb-1 fw-medium">{{ abonnement.compagnie.titre }}</p>
                                        <p class="mb-1 small">{{ abonnement.compagnie.representant }}</p>
                                        <p class="mb-1 small">{{ abonnement.compagnie.contact }}</p>
                                        <p class="mb-0 small">{{ abonnement.compagnie.email }}</p>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <h6 class="fw-bold small text-uppercase text-muted">Abonnement</h6>
                                        <p class="mb-1 small">Réf : <strong>{{ abonnement.reference }}</strong></p>
                                        <p class="mb-1 small">Année : {{ abonnement.annee }}</p>
                                        <p class="mb-1 small">Date : {{ abonnement.createdAt|date('d/m/Y') }}</p>
                                        <p class="mb-0 small">Statut : {% if abonnement.solde %}<span class="badge bg-success">Payée</span>{% else %}<span class="badge bg-warning text-dark">Impayée</span>{% endif %}</p>
                                    </div>
                                </div>
                                <h6 class="fw-bold small text-uppercase text-muted mb-2">Disciplines souscrites</h6>
                                <table class="table table-bordered table-sm">
                                    <thead class="table-success"><tr><th>#</th><th>Discipline</th><th class="text-center">Places</th><th class="text-center">Type</th></tr></thead>
                                    <tbody>
                                        {% for d in disciplines %}
                                        {% set idx = loop.index %}
                                        <tr>
                                            <td>{{ idx }}</td>
                                            <td>{{ d.titre }}</td>
                                            <td class="text-center">{{ d.joueur }}</td>
                                            <td class="text-center">{% if idx > 4 %}<span class="badge bg-info">Suppl.</span>{% else %}<span class="badge bg-secondary">Base</span>{% endif %}</td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                                <hr>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-0">Formule :</p>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <p class="small mb-0">{{ totalDisciplines > 4 ? 'Avec disciplines supplémentaires' : 'Jusqu\'à 4 disciplines' }}</p>
                                        <h4 class="fw-bold mt-2" style="color:#468f34;">{{ montantAbonnement|number_format(0, ',', ' ') }} F CFA</h4>
                                    </div>
                                </div>
                                <div class="text-center mt-4">
                                    <a href="{{ absolute_url(path('app_frontend_membre_facture_pdf')) }}" class="btn btn-success mb-2" style="border-radius:50px;padding:10px 40px;background:#468f34;border-color:#468f34;">
                                        <i class="bi bi-download"></i> Télécharger la facture PDF
                                    </a>
                                </div>
                                <hr>
                                <div class="text-center">
                                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Partager votre reçu de paiement</h6>
                                    {% if abonnement.justificatif %}
                                        <div class="alert alert-success py-2 mb-2">
                                            <i class="bi bi-check-circle"></i> Reçu déjà envoyé.
                                            <a href="{{ absolute_url(asset('upload/justificatifs/')) }}/{{ abonnement.justificatif }}" target="_blank" class="btn btn-sm btn-outline-success ms-2" style="border-radius:50px;">
                                                <i class="bi bi-eye"></i> Voir
                                            </a>
                                        </div>
                                        <form id="recuForm" enctype="multipart/form-data" class="mt-2">
                                            <small class="text-muted">Remplacer le reçu :</small>
                                            <div class="row g-2 justify-content-center mt-1">
                                                <div class="col-md-5">
                                                    <input type="file" name="recu" id="recuInput" class="form-control form-control-sm" accept="image/*,.pdf" required>
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="submit" class="btn btn-outline-warning btn-sm" style="border-radius:50px;">
                                                        <i class="bi bi-arrow-clockwise"></i> Remplacer
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    {% else %}
                                        <form id="recuForm" enctype="multipart/form-data">
                                            <div class="row g-2 justify-content-center">
                                                <div class="col-md-5">
                                                    <input type="file" name="recu" id="recuInput" class="form-control form-control-sm" accept="image/*,.pdf" required>
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="submit" class="btn btn-outline-success btn-sm" style="border-radius:50px;">
                                                        <i class="bi bi-upload"></i> Envoyer
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="bi bi-receipt" style="font-size:3rem;color:#ddd;"></i>
                                    <p class="text-muted mt-2">Aucun abonnement actif.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="notifications" role="tabpanel" aria-labelledby="notifications-tab">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Notifications</h5>
                            {% if unreadCount > 0 %}
                                <span class="badge bg-danger rounded-pill">{{ unreadCount }} non lue(s)</span>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            {% if notifications is empty %}
                                <div class="text-center py-4">
                                    <i class="bi bi-bell" style="font-size:3rem;color:#ddd;"></i>
                                    <p class="text-muted mt-2">Aucune notification</p>
                                </div>
                            {% else %}
                                {% for notif in notifications %}
                                    {% set read = notif.isReadBy(app.user.id) %}
                                    <div class="notification-item d-flex align-items-start p-3 {{ read ? '' : 'bg-light' }}" style="border-bottom:1px solid #eee;border-radius:8px;margin-bottom:4px;" data-id="{{ notif.id }}">
                                        <div class="me-3 mt-1">
                                            {% if not read %}
                                                <span class="badge bg-danger rounded-pill" style="width:10px;height:10px;display:block;padding:0;">&nbsp;</span>
                                            {% endif %}
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong class="small">{{ notif.title }}</strong>
                                                <small class="text-muted">{{ notif.createdAt|date('d/m/Y H:i') }}</small>
                                            </div>
                                            <p class="mb-0 small text-muted mt-1">{{ notif.message }}</p>
                                        </div>
                                        {% if not read %}
                                            <button class="btn btn-sm btn-outline-secondary ms-2 mark-read" data-id="{{ notif.id }}" style="border-radius:50px;">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="addDisciplineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addDisciplineModalTitle">Ajouter des disciplines</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3" id="addDisciplineInfoText">Les 4 premières disciplines sont en formule de base. Au-delà, elles deviennent supplémentaires.</p>
                    <div id="maxLimitMessage" class="alert d-none mb-3" style="background:#fff3e0;color:#ed741f;border:1px solid #ed741f;border-radius:8px;font-size:0.9rem;">
                        <i class="bi bi-exclamation-triangle"></i> Maximum de <strong>4 disciplines</strong> atteint
                    </div>
                    <div class="row g-3" id="disciplineCheckboxList">
                        {% set existingCount = selectedDisciplineIds|length %}
                        {% set maxSelectable = 4 - existingCount %}
                        {% for d in allDisciplines %}
                            {% set in = d.id in selectedDisciplineIds %}
                            <div class="col-md-6">
                                <label class="discipline-card {{ in ? 'already-selected' : '' }}">
                                    <input type="checkbox" class="discipline-checkbox"
                                           value="{{ d.id }}" {{ in ? 'disabled' : '' }}
                                           data-titre="{{ d.titre }}" data-joueur="{{ d.joueur }}"
                                           data-max="{{ maxSelectable }}">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-medium">{{ d.titre }}</span>
                                            <span class="badge" style="background:#468f34;border-radius:50px;">{{ d.joueur }} joueur(s)</span>
                                        </div>
                                        {% if in %}
                                            <small class="text-success mt-1 d-block"><i class="bi bi-check-circle"></i> Déjà sélectionnée</small>
                                        {% endif %}
                                    </div>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <span id="selectedCountBadge" class="text-muted">0 discipline(s) sélectionnée(s)</span>
                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-success" id="confirmAddDiscipline">Ajouter</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modifyDisciplineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modifier la discipline</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Choisissez une nouvelle discipline pour remplacer <strong id="oldDisciplineName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Nouvelle discipline</label>
                        <select id="modifyDisciplineSelect" class="form-select">
                            <option value="">Choisir...</option>
                            {% for d in allDisciplines %}
                                {% if d.id not in selectedDisciplineIds %}
                                    <option value="{{ d.id }}">{{ d.titre }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-warning" id="confirmModifyDiscipline">Modifier</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="participantDisciplineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajouter des participants à la discipline</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Sélectionnez les participants à assigner à cette discipline.</p>
                    <select id="participantSelect" class="form-select" multiple style="width:100%;min-height:200px;">
                    </select>
                    <div id="noParticipantsMsg" class="text-center text-muted py-3 d-none">
                        <i class="bi bi-people"></i> Tous les participants ont déjà une discipline.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-success" id="confirmAssignParticipants">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modifyParticipantDisciplineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modifier la discipline du participant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <select id="participantDisciplineSelect" class="form-select">
                        <option value="">Choisir...</option>
                        {% for discipline in disciplines %}
                            <option value="{{ discipline.id }}">{{ discipline.titre }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-success" id="confirmModifyParticipantDiscipline">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Changer la photo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nouvelle photo</label>
                        <input type="file" id="photoInput" class="form-control" accept="image/*">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary" id="confirmPhoto">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="carteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Changer la carte</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nouvelle carte</label>
