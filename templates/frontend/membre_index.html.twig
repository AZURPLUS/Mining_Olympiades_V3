{% block javascripts %}
    {{ parent() }}
    <script>
        let currentParticipantId = null;
        let currentPage = 1;
        let currentDisciplineFilter = 0;
        let currentModifyDisciplineId = null;
        let currentDetailDisciplineId = null;
        const MEDIA_PATH = '{{ absolute_url(asset('upload/participant/' ~ compagnieSlug ~ '/')) }}';

        document.addEventListener('DOMContentLoaded', function () {
            const discCount = {{ totalDisciplines }};
            const label = document.getElementById('addDisciplineBtnLabel');
            if (label && discCount >= 4) {
                label.textContent = 'Ajouter une discipline supplémentaire';
            }

            document.getElementById('addDisciplineModal').addEventListener('show.bs.modal', function () {
                const existing = {{ selectedDisciplineIds|length }};
                const title = document.getElementById('addDisciplineModalTitle');
                const info = document.getElementById('addDisciplineInfoText');
                if (existing >= 4) {
                    title.textContent = 'Ajouter une discipline supplémentaire';
                    if (info) info.textContent = 'Vous êtes en formule supplémentaire. Vous pouvez ajouter des disciplines supplémentaires.';
                } else {
                    title.textContent = 'Choisir des disciplines (max ' + (4 - existing) + ')';
                    if (info) info.textContent = 'Choisissez jusqu\'à ' + (4 - existing) + ' discipline(s) pour compléter votre formule de base.';
                }
            });

            loadParticipants(1);

            document.querySelectorAll('.voir-participants').forEach(btn => {
                btn.addEventListener('click', function () {
                    const disciplineId = this.dataset.disciplineId;
                    const disciplineTitre = this.dataset.disciplineTitre;
                    currentDetailDisciplineId = disciplineId;
                    document.getElementById('detailParticipantsTitle').textContent =
                        'Participants - ' + disciplineTitre;
                    loadDetailParticipants(disciplineId);
                    new bootstrap.Modal(document.getElementById('detailParticipantsModal')).show();
                });
            });

            document.querySelectorAll('.supprimer-discipline').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.disciplineId;
                    const titre = this.dataset.disciplineTitre;
                    Swal.fire({
                        title: 'Supprimer la discipline ?',
                        text: `Voulez-vous retirer "${titre}" de votre abonnement ?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Oui, supprimer',
                        cancelButtonText: 'Annuler'
                    }).then(result => {
                        if (result.isConfirmed) {
                            fetch(`{{ absolute_url(path('app_frontend_membre_api_discipline_remove', {id: 0})) }}`.replace('0', id), {
                                method: 'DELETE',
                            }).then(r => r.json()).then(data => {
                                if (data.success) {
                                    Swal.fire('Supprimé', data.message, 'success');
                                    location.reload();
                                } else {
                                    Swal.fire('Erreur', data.error, 'error');
                                }
                            });
                        }
                    });
                });
            });

            document.querySelectorAll('.modifier-discipline').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentModifyDisciplineId = this.dataset.disciplineId;
                    const options = document.getElementById('modifyDisciplineSelect');
                    document.getElementById('oldDisciplineName').textContent =
                        this.closest('tr').querySelector('td:first-child').textContent.trim();
                    new bootstrap.Modal(document.getElementById('modifyDisciplineModal')).show();
                });
            });

            document.querySelectorAll('.ajouter-participant').forEach(btn => {
                btn.addEventListener('click', function () {
                    const disciplineId = this.dataset.disciplineId;
                    currentModifyDisciplineId = disciplineId;
                    const select = document.getElementById('participantSelect');
                    select.innerHTML = '<option value="" disabled>Chargement...</option>';
                    const msg = document.getElementById('noParticipantsMsg');
                    msg.classList.add('d-none');

                    fetch('{{ absolute_url(path('app_frontend_membre_api_participants_sans_discipline')) }}')
                        .then(r => r.json())
                        .then(data => {
                            select.innerHTML = '';
                            if (data.data.length === 0) {
                                msg.classList.remove('d-none');
                            } else {
                                data.data.forEach(p => {
                                    const opt = document.createElement('option');
                                    opt.value = p.id;
                                    opt.textContent = p.nom + (p.matricule ? ' (' + p.matricule + ')' : '');
                                    select.appendChild(opt);
                                });
                            }
                        });

                    new bootstrap.Modal(document.getElementById('participantDisciplineModal')).show();
                });
            });

            document.getElementById('confirmAddDiscipline').addEventListener('click', function () {
                const checked = document.querySelectorAll('.discipline-checkbox:checked:not(:disabled)');
                if (checked.length === 0) {
                    Swal.fire('Erreur', 'Veuillez cocher au moins une discipline', 'warning');
                    return;
                }
                const totalAdding = checked.length;
                const formData = new FormData();
                checked.forEach(cb => formData.append('disciplines[]', cb.value));
                fetch('{{ absolute_url(path('app_frontend_membre_api_discipline_add')) }}', {
                    method: 'POST',
                    body: formData,
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('addDisciplineModal')).hide();
                        Swal.fire('Ajouté', data.message, 'success');
                        location.reload();
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                });
            });

            document.querySelectorAll('.discipline-checkbox:not(:disabled)').forEach(cb => {
                cb.addEventListener('change', function () {
                    const existing = {{ selectedDisciplineIds|length }};
                    const checked = document.querySelectorAll('.discipline-checkbox:checked:not(:disabled)').length;
                    const msg = document.getElementById('maxLimitMessage');
                    const totalAfter = existing + checked;

                    if (existing < 4 && this.checked && totalAfter > 4) {
                        this.checked = false;
                        msg.classList.remove('d-none');
                        setTimeout(() => msg.classList.add('d-none'), 3000);
                        return;
                    }

                    this.closest('.discipline-card').classList.toggle('selected', this.checked);
                    msg.classList.add('d-none');
                    const count = document.querySelectorAll('.discipline-checkbox:checked:not(:disabled)').length;
                    document.getElementById('selectedCountBadge').textContent = count + ' discipline(s) sélectionnée(s)';
                });
            });

            document.getElementById('confirmModifyDiscipline').addEventListener('click', function () {
                const select = document.getElementById('modifyDisciplineSelect');
                const newDisciplineId = select.value;
                if (!newDisciplineId) {
                    Swal.fire('Erreur', 'Veuillez choisir une discipline', 'warning');
                    return;
                }
                fetch(`{{ absolute_url(path('app_frontend_membre_api_discipline_update', {id: 0})) }}`.replace('0', currentModifyDisciplineId), {
                    method: 'PUT',
                    body: JSON.stringify({discipline: parseInt(newDisciplineId)}),
                    headers: {'Content-Type': 'application/json'},
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modifyDisciplineModal')).hide();
                        Swal.fire('Modifié', data.message, 'success');
                        location.reload();
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                });
            });

            document.getElementById('confirmAssignParticipants').addEventListener('click', function () {
                const select = document.getElementById('participantSelect');
                const selected = Array.from(select.selectedOptions).map(o => o.value);
                if (selected.length === 0) {
                    Swal.fire('Erreur', 'Veuillez sélectionner au moins un participant', 'warning');
                    return;
                }
                if (!currentModifyDisciplineId) {
                    Swal.fire('Erreur', 'Discipline non identifiée', 'error');
                    return;
                }
                const disciplineId = currentModifyDisciplineId;
                const btn = this;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                fetch(`{{ absolute_url(path('app_frontend_membre_api_participants_assign_discipline', {id: 0})) }}`.replace('0', disciplineId), {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({participants: selected}),
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('participantDisciplineModal')).hide();
                        Swal.fire('Ajoutés', data.message, 'success');
                        loadParticipants(currentPage);
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                    btn.disabled = false;
                    btn.innerHTML = 'Enregistrer';
                }).catch(() => {
                    Swal.fire('Erreur', 'Une erreur est survenue', 'error');
                    btn.disabled = false;
                    btn.innerHTML = 'Enregistrer';
                });
            });

            document.getElementById('confirmModifyParticipantDiscipline').addEventListener('click', function () {
                const select = document.getElementById('participantDisciplineSelect');
                const disciplineId = select.value;
                if (!disciplineId) {
                    Swal.fire('Erreur', 'Veuillez choisir une discipline', 'warning');
                    return;
                }
                if (!currentParticipantId) {
                    Swal.fire('Erreur', 'Participant non identifié', 'error');
                    return;
                }
                fetch(`{{ absolute_url(path('app_frontend_membre_api_participant_discipline', {id: 0})) }}`.replace('0', currentParticipantId), {
                    method: 'PUT',
                    body: JSON.stringify({discipline: parseInt(disciplineId)}),
                    headers: {'Content-Type': 'application/json'},
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modifyParticipantDisciplineModal')).hide();
                        Swal.fire('Ajouté', data.message, 'success');
                        loadParticipants(currentPage);
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                });
            });

            document.getElementById('confirmPhoto').addEventListener('click', function () {
                const fileInput = document.getElementById('photoInput');
                if (!fileInput.files.length) {
                    Swal.fire('Erreur', 'Veuillez choisir une photo', 'warning');
                    return;
                }
                const formData = new FormData();
                formData.append('media', fileInput.files[0]);
                fetch(`{{ absolute_url(path('app_frontend_membre_api_participant_photo', {id: 0})) }}`.replace('0', currentParticipantId), {
                    method: 'POST',
                    body: formData,
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('photoModal')).hide();
                        Swal.fire('OK', data.message, 'success');
                        loadParticipants(currentPage);
                        loadDetailParticipants(currentDetailDisciplineId);
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                });
            });

            document.getElementById('confirmCarte').addEventListener('click', function () {
                const fileInput = document.getElementById('carteInput');
                if (!fileInput.files.length) {
                    Swal.fire('Erreur', 'Veuillez choisir une carte', 'warning');
                    return;
                }
                const formData = new FormData();
                formData.append('carte', fileInput.files[0]);
                fetch(`{{ absolute_url(path('app_frontend_membre_api_participant_carte', {id: 0})) }}`.replace('0', currentParticipantId), {
                    method: 'POST',
                    body: formData,
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('carteModal')).hide();
                        Swal.fire('OK', data.message, 'success');
                        loadParticipants(currentPage);
                        loadDetailParticipants(currentDetailDisciplineId);
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                });
            });

            document.getElementById('confirmInfo').addEventListener('click', function () {
                const data = {
                    nom: document.getElementById('infoNom').value,
                    prenoms: document.getElementById('infoPrenoms').value,
                    matricule: document.getElementById('infoMatricule').value,
                    contact: document.getElementById('infoContact').value,
                    email: document.getElementById('infoEmail').value,
                };
                fetch(`{{ absolute_url(path('app_frontend_membre_api_participant_info', {id: 0})) }}`.replace('0', currentParticipantId), {
                    method: 'PUT',
                    body: JSON.stringify(data),
                    headers: {'Content-Type': 'application/json'},
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('infoModal')).hide();
                        Swal.fire('OK', data.message, 'success');
                        loadParticipants(currentPage);
                        loadDetailParticipants(currentDetailDisciplineId);
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                    }
                });
            });

            document.getElementById('filterDiscipline').addEventListener('change', function () {
                currentDisciplineFilter = parseInt(this.value);
                loadParticipants(1);
            });
        });

        function loadParticipants(page) {
            currentPage = page;
            const tbody = document.getElementById('participantsBody');
            tbody.innerHTML = '<tr><td colspan="11" class="text-center py-4"><div class="spinner-border text-success"></div></td></tr>';

            let url = `{{ absolute_url(path('app_frontend_membre_api_participants')) }}?page=${page}&limit=10`;
            if (currentDisciplineFilter > 0) {
                url += `&discipline=${currentDisciplineFilter}`;
            }

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (data.data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="11" class="text-center py-4 text-muted">Aucun participant trouvé</td></tr>';
                    } else {
                        tbody.innerHTML = '';
                        data.data.forEach(p => {
                            const mediaUrl = p.media
                                ? MEDIA_PATH + p.media
                                : `{{ absolute_url(asset('assets/images/avatar.png')) }}`;
                            const carteUrl = p.carte
                                ? MEDIA_PATH + p.carte
                                : `{{ absolute_url(asset('assets/images/avatar.png')) }}`;
                            const disciplines = p.disciplines.map(d => d.titre).join(', ') || 'Aucune';

                            tbody.innerHTML += `
                                <tr id="participant-row-${p.id}">
                                    <td><img src="${mediaUrl}" class="media-thumb" alt="photo" onerror="this.src='{{ absolute_url(asset('assets/images/avatar.png')) }}'"></td>
                                    <td><img src="${carteUrl}" class="media-thumb-sm" alt="carte" onerror="this.src='{{ absolute_url(asset('assets/images/avatar.png')) }}'"></td>
                                    <td>${escapeHtml(p.nom || '')}</td>
                                    <td>${escapeHtml(p.prenoms || '')}</td>
                                    <td>${escapeHtml(p.email || '')}</td>
                                    <td>${escapeHtml(p.contact || '')}</td>
                                    <td>${escapeHtml(p.matricule || '')}</td>
                                    <td>${escapeHtml(p.licence || '')}</td>
                                    <td>${escapeHtml(disciplines)}</td>
                                    <td class="text-center">${renderStatus(p.status, p.rejectMessage)}</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-warning modifier-participant-discipline" data-id="${p.id}" title="Modifier discipline"><i class="bi bi-arrow-repeat"></i></button>
                                            <button class="btn btn-outline-danger supprimer-participant" data-id="${p.id}" data-nom="${escapeHtml(p.nom || '')} ${escapeHtml(p.prenoms || '')}" title="Supprimer"><i class="bi bi-trash"></i></button>
                                            <button class="btn btn-outline-primary changer-photo" data-id="${p.id}" title="Photo"><i class="bi bi-camera"></i></button>
                                            <button class="btn btn-outline-info changer-carte" data-id="${p.id}" title="Carte"><i class="bi bi-card-image"></i></button>
                                            <button class="btn btn-outline-secondary modifier-infos" data-id="${p.id}" data-nom="${escapeHtml(p.nom || '')}" data-prenoms="${escapeHtml(p.prenoms || '')}" data-matricule="${escapeHtml(p.matricule || '')}" data-contact="${escapeHtml(p.contact || '')}" data-email="${escapeHtml(p.email || '')}" title="Infos"><i class="bi bi-pencil"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });

                        attachParticipantEvents();
                    }

                    renderPagination(data.page, data.pages, data.total);
                });
        }

        function loadDetailParticipants(disciplineId) {
            const tbody = document.getElementById('detailParticipantsBody');
            tbody.innerHTML = '<tr><td colspan="9" class="text-center py-3"><div class="spinner-border text-success"></div></td></tr>';

            fetch(`{{ absolute_url(path('app_frontend_membre_api_participants')) }}?limit=1000&discipline=${disciplineId}`)
                .then(r => r.json())
                .then(data => {
                    if (data.data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="10" class="text-center py-3 text-muted">Aucun participant dans cette discipline</td></tr>';
                    } else {
                        tbody.innerHTML = '';
                        data.data.forEach(p => {
                            const hasDiscipline = p.disciplines.some(d => d.id == disciplineId);
                            const mediaUrl = p.media
                                ? MEDIA_PATH + p.media
                                : `{{ absolute_url(asset('assets/images/avatar.png')) }}`;
                            const carteUrl = p.carte
                                ? MEDIA_PATH + p.carte
                                : `{{ absolute_url(asset('assets/images/avatar.png')) }}`;

                            tbody.innerHTML += `
                                <tr>
                                    <td><img src="${mediaUrl}" class="media-thumb" alt="photo" onerror="this.src='{{ absolute_url(asset('assets/images/avatar.png')) }}'"></td>
                                    <td><img src="${carteUrl}" class="media-thumb-sm" alt="carte" onerror="this.src='{{ absolute_url(asset('assets/images/avatar.png')) }}'"></td>
                                    <td>${escapeHtml(p.nom || '')}</td>
                                    <td>${escapeHtml(p.prenoms || '')}</td>
                                    <td>${escapeHtml(p.matricule || '')}</td>
                                    <td>${escapeHtml(p.contact || '')}</td>
                                    <td>${escapeHtml(p.email || '')}</td>
                                    <td>${escapeHtml(p.licence || '')}</td>
                                    <td>${renderStatus(p.status, p.rejectMessage)}</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary changer-photo" data-id="${p.id}" title="Modifier media"><i class="bi bi-camera"></i></button>
                                            <button class="btn btn-outline-secondary modifier-infos" data-id="${p.id}" data-nom="${escapeHtml(p.nom || '')}" data-prenoms="${escapeHtml(p.prenoms || '')}" data-matricule="${escapeHtml(p.matricule || '')}" data-contact="${escapeHtml(p.contact || '')}" data-email="${escapeHtml(p.email || '')}" title="Modifier info"><i class="bi bi-pencil"></i></button>
                                            ${hasDiscipline ? `<button class="btn btn-outline-danger retirer-discipline" data-id="${p.id}" data-discipline-id="${disciplineId}" title="Retirer"><i class="bi bi-x-circle"></i></button>` : ''}
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });
                    }

                    document.querySelectorAll('.retirer-discipline').forEach(btn => {
                        btn.addEventListener('click', function () {
                            const pid = this.dataset.id;
                            const did = this.dataset.disciplineId;
                            Swal.fire({
                                title: 'Retirer ?',
                                text: 'Retirer ce participant de la discipline ?',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Retirer',
                                cancelButtonText: 'Annuler'
                            }).then(r => {
                                if (r.isConfirmed) {
                                    fetch(`{{ absolute_url(path('app_frontend_membre_api_participant_discipline_remove', {id: 0, disciplineId: 0})) }}`.replace('/0/discipline/0', `/${pid}/discipline/${did}`), {
                                        method: 'DELETE',
                                    }).then(res => res.json()).then(data => {
                                        if (data.success) {
                                            Swal.fire('Retiré', data.message, 'success');
                                            loadDetailParticipants(disciplineId);
                                            loadParticipants(currentPage);
                                        } else {
                                            Swal.fire('Erreur', data.error, 'error');
                                        }
                                    });
                                }
                            });
                        });
                    });

                    attachDetailEvents();
                });
        }

        function attachParticipantEvents() {
            document.querySelectorAll('.modifier-participant-discipline').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentParticipantId = parseInt(this.dataset.id);
                    const discSelect = document.getElementById('participantDisciplineSelect');
                    discSelect.innerHTML = '<option value="">Chargement...</option>';

                    fetch('{{ absolute_url(path('app_frontend_membre_api_disciplines')) }}')
                        .then(r => r.json())
                        .then(data => {
                            discSelect.innerHTML = '<option value="">Choisir...</option>';
                            data.disciplines.forEach(d => {
                                const opt = document.createElement('option');
                                opt.value = d.id;
                                opt.textContent = d.titre + ' (' + d.count + '/' + d.required + ')';
                                if (d.remaining <= 0) opt.disabled = true;
                                discSelect.appendChild(opt);
                            });
                        });

                    new bootstrap.Modal(document.getElementById('modifyParticipantDisciplineModal')).show();
                });
            });

            document.querySelectorAll('.supprimer-participant').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.id;
                    const nom = this.dataset.nom;
                    Swal.fire({
                        title: 'Supprimer ?',
                        text: `Supprimer définitivement ${nom} ?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Supprimer',
                        cancelButtonText: 'Annuler'
                    }).then(r => {
                        if (r.isConfirmed) {
                            fetch(`{{ absolute_url(path('app_frontend_membre_api_participant_delete', {id: 0})) }}`.replace('0', id), {
                                method: 'DELETE',
                            }).then(res => res.json()).then(data => {
                                if (data.success) {
                                    Swal.fire('Supprimé', data.message, 'success');
                                    loadParticipants(currentPage);
                                } else {
                                    Swal.fire('Erreur', data.error, 'error');
                                }
                            });
                        }
                    });
                });
            });

            document.querySelectorAll('.changer-photo').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentParticipantId = parseInt(this.dataset.id);
                    document.getElementById('photoInput').value = '';
                    new bootstrap.Modal(document.getElementById('photoModal')).show();
                });
            });

            document.querySelectorAll('.changer-carte').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentParticipantId = parseInt(this.dataset.id);
                    document.getElementById('carteInput').value = '';
                    new bootstrap.Modal(document.getElementById('carteModal')).show();
                });
            });

            document.querySelectorAll('.modifier-infos').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentParticipantId = parseInt(this.dataset.id);
                    document.getElementById('infoNom').value = this.dataset.nom;
                    document.getElementById('infoPrenoms').value = this.dataset.prenoms;
                    document.getElementById('infoMatricule').value = this.dataset.matricule;
                    document.getElementById('infoContact').value = this.dataset.contact;
                    document.getElementById('infoEmail').value = this.dataset.email;
                    new bootstrap.Modal(document.getElementById('infoModal')).show();
                });
            });
        }

        function attachDetailEvents() {
            document.querySelectorAll('#detailParticipantsBody .changer-photo').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentParticipantId = parseInt(this.dataset.id);
                    document.getElementById('photoInput').value = '';
                    new bootstrap.Modal(document.getElementById('photoModal')).show();
                });
            });

            document.querySelectorAll('#detailParticipantsBody .modifier-infos').forEach(btn => {
                btn.addEventListener('click', function () {
                    currentParticipantId = parseInt(this.dataset.id);
                    document.getElementById('infoNom').value = this.dataset.nom;
                    document.getElementById('infoPrenoms').value = this.dataset.prenoms;
                    document.getElementById('infoMatricule').value = this.dataset.matricule;
                    document.getElementById('infoContact').value = this.dataset.contact;
                    document.getElementById('infoEmail').value = this.dataset.email;
                    new bootstrap.Modal(document.getElementById('infoModal')).show();
                });
            });
        }

        function renderPagination(current, total, count) {
            const nav = document.getElementById('participantsPagination');
            if (total <= 1) {
                nav.innerHTML = count > 0
                    ? `<p class="text-muted small mb-0">${count} participant(s)</p>`
                    : '';
                return;
            }

            let html = `<p class="text-muted small mb-2">${count} participant(s) - Page ${current}/${total}</p>`;
            html += '<ul class="pagination pagination-sm justify-content-center mb-0">';

            if (current > 1) {
                html += `<li class="page-item"><a class="page-link" href="#" data-page="1">&laquo;</a></li>`;
                html += `<li class="page-item"><a class="page-link" href="#" data-page="${current - 1}">&lsaquo;</a></li>`;
            }

            const start = Math.max(1, current - 2);
            const end = Math.min(total, current + 2);
            for (let i = start; i <= end; i++) {
                html += `<li class="page-item ${i === current ? 'active' : ''}"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
            }

            if (current < total) {
                html += `<li class="page-item"><a class="page-link" href="#" data-page="${current + 1}">&rsaquo;</a></li>`;
                html += `<li class="page-item"><a class="page-link" href="#" data-page="${total}">&raquo;</a></li>`;
            }

            html += '</ul>';
            nav.innerHTML = html;

            nav.querySelectorAll('.page-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    loadParticipants(parseInt(this.dataset.page));
                });
            });
        }

        function renderStatus(status, rejectMessage) {
            if (status === 'validated') return '<span class="badge bg-success">Validé</span>';
            if (status === 'rejected') return '<span class="badge bg-danger">Rejeté</span><br>' +
                                                '<small style="cursor:pointer;color:#ed741f;" onclick=\'Swal.fire("Motif du rejet", ' +
                                                JSON.stringify(rejectMessage || 'Aucun motif') +
                                                ', "info")\'>' +
                                                '<i class="bi bi-eye"></i> Voir motif</small>';
            return '<span class="badge bg-warning text-dark">En attente</span>';
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        const recuForm = document.getElementById('recuForm');
        if (recuForm) {
            recuForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const input = document.getElementById('recuInput');
                if (!input.files.length) {
                    Swal.fire('Erreur', 'Veuillez choisir un fichier', 'warning');
                    return;
                }
                const btn = recuForm.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Envoi...';
                const formData = new FormData();
                formData.append('recu', input.files[0]);
                fetch('{{ absolute_url(path('app_frontend_membre_facture_recu')) }}', {
                    method: 'POST',
                    body: formData,
                }).then(r => r.json()).then(data => {
                    if (data.success) {
                        Swal.fire('Envoyé !', data.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Erreur', data.error, 'error');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-upload"></i> Envoyer';
                    }
                }).catch(() => {
                    Swal.fire('Erreur', 'Une erreur est survenue', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-upload"></i> Envoyer';
                });
            });
        }

        document.querySelectorAll('.mark-read').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.dataset.id;
                const item = this.closest('.notification-item');
                fetch(`{{ absolute_url(path('app_frontend_membre_api_notification_read', {id: 0})) }}`.replace('0', id), {
                    method: 'POST'
                }).then(() => {
                    item.classList.remove('bg-light');
                    const dot = item.querySelector('.badge');
                    if (dot) dot.remove();
                    this.remove();
                    const badge = document.querySelector('.card-header .badge');
                    if (badge) {
                        const count = parseInt(badge.textContent) - 1;
                        if (count > 0) badge.textContent = count + ' non lue(s)';
                        else badge.remove();
                    }
                });
            });
        });
    </script>
{% endblock %}